    <pous>
      <pou name="EOS_AO" pouType="function">
        <interface>
          <returnType>
            <UINT/>
          </returnType>
          <inputVars>
            <variable name="PCT">
              <type>
                <REAL/>
              </type>
            </variable>
          </inputVars>
        </interface>
        <body>
          <ST>
            <xhtml:p><![CDATA[EOS_AO := REAL_TO_UINT(LIMIT(0.0, PCT, 100.0) * 655.35);]]></xhtml:p>
          </ST>
        </body>
        <documentation>
          <xhtml:p>PWM output: 0..100 % to the 0..65535 range OpenPLC writes to %QW.</xhtml:p>
        </documentation>
      </pou>
      <pou name="EOS_BLINK" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="EN_IN">
              <type>
                <BOOL/>
              </type>
            </variable>
            <variable name="T_ON">
              <type>
                <TIME/>
              </type>
            </variable>
            <variable name="T_OFF">
              <type>
                <TIME/>
              </type>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="Q">
              <type>
                <BOOL/>
              </type>
            </variable>
          </outputVars>
          <localVars>
            <variable name="t_on_phase">
              <type>
                <derived name="TON"/>
              </type>
            </variable>
            <variable name="t_off_phase">
              <type>
                <derived name="TON"/>
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml:p><![CDATA[t_on_phase(IN := EN_IN AND NOT t_off_phase.Q, PT := T_ON);
t_off_phase(IN := t_on_phase.Q, PT := T_OFF);
Q := EN_IN AND NOT t_on_phase.Q;]]></xhtml:p>
          </ST>
        </body>
        <documentation>
          <xhtml:p>Blinker: while EN_IN is TRUE, Q is TRUE for T_ON then FALSE for T_OFF.</xhtml:p>
        </documentation>
      </pou>
      <pou name="EOS_SCALE" pouType="function">
        <interface>
          <returnType>
            <REAL/>
          </returnType>
          <inputVars>
            <variable name="IN">
              <type>
                <REAL/>
              </type>
            </variable>
            <variable name="IN_MIN">
              <type>
                <REAL/>
              </type>
            </variable>
            <variable name="IN_MAX">
              <type>
                <REAL/>
              </type>
            </variable>
            <variable name="OUT_MIN">
              <type>
                <REAL/>
              </type>
            </variable>
            <variable name="OUT_MAX">
              <type>
                <REAL/>
              </type>
            </variable>
            <variable name="CLAMP">
              <type>
                <BOOL/>
              </type>
            </variable>
          </inputVars>
        </interface>
        <body>
          <ST>
            <xhtml:p><![CDATA[IF IN_MAX = IN_MIN THEN
  EOS_SCALE := OUT_MIN;
ELSE
  EOS_SCALE := OUT_MIN + (IN - IN_MIN) * (OUT_MAX - OUT_MIN) / (IN_MAX - IN_MIN);
  IF CLAMP THEN
    EOS_SCALE := LIMIT(MIN(OUT_MIN, OUT_MAX), EOS_SCALE, MAX(OUT_MIN, OUT_MAX));
  END_IF;
END_IF;]]></xhtml:p>
          </ST>
        </body>
      </pou>
      <pou name="EOS_THRESH" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="IN">
              <type>
                <REAL/>
              </type>
            </variable>
            <variable name="ON_LEVEL">
              <type>
                <REAL/>
              </type>
            </variable>
            <variable name="OFF_LEVEL">
              <type>
                <REAL/>
              </type>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="Q">
              <type>
                <BOOL/>
              </type>
            </variable>
          </outputVars>
        </interface>
        <body>
          <ST>
            <xhtml:p><![CDATA[IF ON_LEVEL >= OFF_LEVEL THEN
  IF IN >= ON_LEVEL THEN Q := TRUE; ELSIF IN <= OFF_LEVEL THEN Q := FALSE; END_IF;
ELSE
  IF IN <= ON_LEVEL THEN Q := TRUE; ELSIF IN >= OFF_LEVEL THEN Q := FALSE; END_IF;
END_IF;]]></xhtml:p>
          </ST>
        </body>
        <documentation>
          <xhtml:p>Threshold with hysteresis. ON_LEVEL &gt; OFF_LEVEL: on above ON_LEVEL. ON_LEVEL &lt; OFF_LEVEL: on below ON_LEVEL.</xhtml:p>
        </documentation>
      </pou>
      <pou name="EOS_WEEK" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="DAYS">
              <type>
                <INT/>
              </type>
            </variable>
            <variable name="ON_MIN">
              <type>
                <INT/>
              </type>
            </variable>
            <variable name="OFF_MIN">
              <type>
                <INT/>
              </type>
            </variable>
            <variable name="DOW">
              <type>
                <INT/>
              </type>
            </variable>
            <variable name="MINUTE">
              <type>
                <INT/>
              </type>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="Q">
              <type>
                <BOOL/>
              </type>
            </variable>
          </outputVars>
          <localVars>
            <variable name="today">
              <type>
                <BOOL/>
              </type>
            </variable>
            <variable name="yesterday">
              <type>
                <BOOL/>
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml:p><![CDATA[today := (SHR(INT_TO_WORD(DAYS), DOW) AND 16#0001) <> 0;
yesterday := (SHR(INT_TO_WORD(DAYS), (DOW + 6) MOD 7) AND 16#0001) <> 0;
IF ON_MIN <= OFF_MIN THEN
  Q := today AND MINUTE >= ON_MIN AND MINUTE < OFF_MIN;
ELSE
  Q := (today AND MINUTE >= ON_MIN) OR (yesterday AND MINUTE < OFF_MIN);
END_IF;]]></xhtml:p>
          </ST>
        </body>
        <documentation>
          <xhtml:p>Weekly timer. DAYS bit 0 = Sunday. DOW (0 = Sunday) and MINUTE (minute of the day) must come from a clock.</xhtml:p>
        </documentation>
      </pou>
