  "_generate": {
    "terminals41": "schema 1, id t-x, name X, 41 terminals labelled T1..T41 that all use gpio 23 is NOT what is meant: build 41 terminals T1..T41 each {gpio: 23, uses:[\"di\"]}; it must be rejected (count or duplicate gpio, either reason is fine).",
    "oversize": "schema 1, id t-x, name X, one valid terminal {label IO1, gpio 23, uses [do]} plus a top-level key \"pad\" holding a string of 4100 'x' characters; it must be rejected for size (> 4096 bytes serialized)."
